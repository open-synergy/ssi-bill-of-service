<odoo>
<record id="bill_of_service_pricelist_rule_ou" model="ir.rule">
    <field
            name="name"
        >Bill of Service To Pricelist - Responsible to operating unit data</field>
    <field name="model_id" ref="ssi_bill_of_service.model_bill_of_service_pricelist" />
    <field name="groups" eval="[(4, ref('bill_of_service_pricelist_ou_group'))]" />
    <field
            name="domain_force"
        >[('operating_unit_id','in',[g.id for g in user.operating_unit_ids])]</field>
    <field name="perm_unlink" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="1" />
</record>
</odoo>
